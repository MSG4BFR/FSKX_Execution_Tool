# FSKX Runner — local settings.
# Copy this file to ".env" (same folder, next to run.sh / run.bat) and fill in your key.
# The launcher loads it automatically so you don't re-enter the key each time.
# Keep ".env" private — it is git- and Docker-ignored and never baked into the image.

# Your Anthropic API key (needed only for the optional "AI environment" feature).
# Starts with sk-ant-. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: pin which Claude model the AI builder uses (default: claude-sonnet-4-6).
# FSKX_CLAUDE_MODEL=claude-sonnet-4-6

# --- Local AI backend (optional) -------------------------------------------------------
# Instead of Claude, the AI features (environment builder + "Talk to your model") can use a
# local OpenAI-compatible server such as LM Studio. Set the provider to "local" and point
# the endpoint at your server. NOTE: the app runs inside Docker, so use
# "host.docker.internal" (NOT "localhost") to reach a server running on this machine.
# FSKX_AI_PROVIDER=local
# FSKX_LOCAL_API_URL=http://host.docker.internal:1234/v1
# FSKX_LOCAL_MODEL=google/gemma-3-27b

# Optional: where your .fskx models live and where repository downloads are saved.
# Default: the "fskx_models" folder inside fskx-runner. Relative paths are resolved
# against the fskx-runner folder; absolute paths also work. (Windows: use an absolute path.)
# MODELS_DIR=fskx_models

# Optional: web UI port (default: 8000).
# PORT=8000
